{
  "name": "pharmaerp-print-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local loopback print agent for PharmaERP POS tickets on Windows.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node test/smoke-test.js",
    "build": "node scripts/build.js",
    "build:exe": "npx pkg . --targets node20-win-x64 --output dist/PharmaERP-Print-Agent.exe"
  },
  "bin": {
    "pharmaerp-print-agent": "src/server.js"
  },
  "pkg": {
    "scripts": [
      "src/server.js"
    ],
    "assets": [
      "scripts/print-ticket.ps1"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
